model Notice {
  id          String     @id @default(uuid())
  createdById String
  description String
  type        NoticeType // ENUM: HP, PATIENT, ALL
  toIds       String[] // Array of User IDs or HP IDs (depends on type)
  attachments String[]
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  user User @relation(fields: [createdById], references: [id], onDelete: Cascade)
}

enum NoticeType {
  HP
  PATIENT
  ALL
}
