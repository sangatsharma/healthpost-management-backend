model HealthPost {
  id        String   @id @default(uuid())
  name      String
  location  String
  number    String
  admin     User?    @relation(fields: [adminId], references: [id], onDelete: Cascade)
  adminId   String?  @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("healthpost")
}
