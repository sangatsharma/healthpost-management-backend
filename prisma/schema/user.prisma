// Superadmin and Admin
model User {
  id           String      @id @default(uuid())
  fullName     String
  email        String      @unique
  role         ROLE
  permission   PERMISSIONS
  isVerified   Boolean     @default(false)
  refreshToken String?
  otp          String?
  optCreatedAt DateTime?
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
  HealthPost   HealthPost?

  @@map("user")
}

enum ROLE {
  SUPERADMIN
  ADMIN
  PATIENT
}

enum PERMISSIONS {
  ALL
}
