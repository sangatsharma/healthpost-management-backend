model OpdVisit {
  id                  String            @id @default(uuid())
  visitedDate         DateTime
  patientId           String
  examinerId          String
  healthPostId        String
  complaints          String
  diagnosis           String
  observedExamination String
  treatment           String
  followUpRequired    Boolean?
  followUpDate        DateTime?
  isGenderViolence    Boolean?
  isPregenant         Boolean?
  treatementType      TreatementType
  visitType           VisitType
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt
  medicines           String[]
  opdNo               Int               @default(autoincrement())
  examiner            User              @relation(fields: [examinerId], references: [id], onDelete: Cascade)
  healthPost          HealthPost        @relation(fields: [healthPostId], references: [id], onDelete: Cascade)
  patient             Patient           @relation(fields: [patientId], references: [id], onDelete: Cascade)
  prescriptions       Prescription[]
  vitals              Vitals?
  AssetEngagement     AssetEngagement[]
  referral            OpdReferral?
}

model Vitals {
  id          String   @id
  bp          String?
  pulse       String?
  temperature String?
  respiration String?
  weight      String?
  height      String?
  mucus       String?
  opdVisit    OpdVisit @relation(fields: [id], references: [id])

  @@index([id])
}

model Prescription {
  id          String   @id @default(uuid())
  opdVisitId  String
  name        String
  duration    String
  frequency   String
  intakeTime  String
  quantity    String
  intakeRoute String
  dosage      String
  timing      String
  opdVisit    OpdVisit @relation(fields: [opdVisitId], references: [id])
}

model Medicine {
  id    String  @id
  label String?
}

model OpdReferral {
  id                   String        @id @default(uuid())
  staffId              String
  healthPostId         String
  referredHealthPostId String
  patientId            String
  opdId                String        @unique()
  referralStatus       OpdStatusType @default(PENDING)
  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt

  staff              User       @relation(fields: [staffId], references: [id])
  healthPost         HealthPost @relation("ReferringHealthPost", fields: [healthPostId], references: [id])
  referredHealthPost HealthPost @relation("ReferredToHealthPost", fields: [referredHealthPostId], references: [id])
  patient            Patient    @relation(fields: [patientId], references: [id])
  opdVisit           OpdVisit   @relation(fields: [opdId], references: [id])
}

enum OpdStatusType {
  PENDING
  APPROVED
  REJECTED
}

enum VisitType {
  CONSULTATION
  FOLLOW_UP
  EMERGENCY
  ROUTINE_CHECKUP
  TELEMEDICINE
  HOME_VISIT
  GENERAL
  OTHER
}

enum TreatementType {
  MEDICATION
  SURGERY
  THERAPY
  DIAGNOSTIC_TEST
  REHABILITATION
  PALLIATIVE_CARE
  OTHER
}
