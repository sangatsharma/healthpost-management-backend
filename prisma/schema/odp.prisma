model OpdVisit {
  id                  String         @id @default(uuid())
  visitedDate         DateTime
  patientId           String
  examinerId          String
  healthPostId        String
  complaints          String
  diagnosis           String
  observedExamination String
  treatment           String
  followUpRequired    Boolean?
  followUpDate        DateTime?
  isGenderViolence    Boolean?
  isPregenant         Boolean?
  treatementType      TreatementType
  visitType           VisitType
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt
  medicines           String[]
  opdNo               Int            @default(autoincrement())
  examiner            User           @relation(fields: [examinerId], references: [id], onDelete: Cascade)
  healthPost          HealthPost     @relation(fields: [healthPostId], references: [id], onDelete: Cascade)
  patient             Patient        @relation(fields: [patientId], references: [id], onDelete: Cascade)
  prescriptions       Prescription[]
  vitals              Vitals?
}

model Vitals {
  id          String   @id
  bp          String?
  pulse       String?
  temperature String?
  respiration String?
  weight      String?
  height      String?
  mucus       String?
  opdVisit    OpdVisit @relation(fields: [id], references: [id])

  @@index([id])
}

model Prescription {
  id          String   @id @default(uuid())
  opdVisitId  String
  name        String
  duration    String
  frequency   String
  intakeTime  String
  quantity    String
  intakeRoute String
  dosage      String
  timing      String
  opdVisit    OpdVisit @relation(fields: [opdVisitId], references: [id])
}

model Medicine {
  id    String  @id
  label String?
}

model OpdReferal {
  id                  String   @id @default(uuid())
  staffId             String
  healthPostId        String
  referedHealthPostId String
  patientId           String
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
}

enum VisitType {
  CONSULTATION
  FOLLOW_UP
  EMERGENCY
  ROUTINE_CHECKUP
  TELEMEDICINE
  HOME_VISIT
  GENERAL
  OTHER
}

enum TreatementType {
  MEDICATION
  SURGERY
  THERAPY
  DIAGNOSTIC_TEST
  REHABILITATION
  PALLIATIVE_CARE
  OTHER
}
